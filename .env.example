# Aegis -- environment variables. Copy to .env and fill in.

# Core
AEGIS_ENV=local
LOG_LEVEL=INFO

# LLM
ANTHROPIC_API_KEY=
AEGIS_LLM_MODEL=claude-sonnet-4-5
AEGIS_LLM_MAX_COST_USD_PER_RUN=0.50

# Profile (YAML file -- see profile.example.yaml)
AEGIS_PROFILE_PATH=./profile.yaml

# Data sources
GITHUB_TOKEN=
GITHUB_USERNAME=

# Infrastructure
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

# Scheduler
AEGIS_BRIEFING_CRON=0 7 * * *
AEGIS_TIMEZONE=Asia/Singapore
