# =============================================================================
# Aegis -- copy this file to .env and fill in your values
#
#   cp .env.example .env
#
# Required: ANTHROPIC_API_KEY
# Optional: everything else (features degrade gracefully when not set)
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
AEGIS_ENV=local
LOG_LEVEL=INFO

# ── LLM (required) ───────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

AEGIS_LLM_MODEL=claude-sonnet-4-5
AEGIS_LLM_MAX_COST_USD_PER_RUN=0.50

# ── Your profile ─────────────────────────────────────────────────────────────
# Used for job fit scoring and interview prep personalisation.
# Edit these to match your background.
AEGIS_PROFILE_SKILLS=python,golang,distributed-systems,postgresql,redis,docker,kubernetes,fastapi,async-programming,system-design
AEGIS_PROFILE_TARGET_ROLES=backend-engineer,platform-engineer,ai-engineer
AEGIS_PROFILE_EXPERIENCE_YEARS=3
AEGIS_PROFILE_PREFERRED_LOCATIONS=singapore,remote
AEGIS_PROFILE_DEAL_BREAKERS=php,wordpress

# ── GitHub (optional) ────────────────────────────────────────────────────────
# Enables GitHub notifications + activity in your daily briefing.
# Create a token at https://github.com/settings/tokens (needs: notifications, read:user)
GITHUB_TOKEN=
GITHUB_USERNAME=

# ── LeetCode (optional) ──────────────────────────────────────────────────────
# Enables auto-sync of accepted submissions from your LeetCode profile.
# LEETCODE_SESSION: open leetcode.com, DevTools → Application → Cookies → LEETCODE_SESSION
LEETCODE_USERNAME=
LEETCODE_SESSION=

# ── Infrastructure ────────────────────────────────────────────────────────────
# Leave as-is when using docker compose (make start).
# Change if you're pointing at a remote database.
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

# ── Scheduler ────────────────────────────────────────────────────────────────
# Cron expression for the daily briefing (default: 7am).
AEGIS_BRIEFING_CRON=0 7 * * *
AEGIS_TIMEZONE=Asia/Singapore
